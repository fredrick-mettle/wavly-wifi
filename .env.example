# Supabase (server-side only — never expose the secret key to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Admin console gate (demo). Replace with Supabase Auth for production.
ADMIN_PASSWORD=wavly-demo
ADMIN_SESSION_SECRET=change-me-in-production

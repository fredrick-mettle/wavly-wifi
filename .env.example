# =============================================================================
#  Wavly WiFi — environment configuration
# =============================================================================
#  Copy to .env and fill in. NEVER commit the real file (see .gitignore).
#
#  There are TWO environments, and they must not be merged:
#    A. CLOUD  — set in the Vercel project (Production + Preview)
#    B. EDGE   — set in /etc/wavly/edge.env on the on-site box, mode 0600,
#                owned by the syncd service user
#
#  A secret that only one side needs must only exist on that side. In particular
#  the RADIUS shared secret exists ONLY on the edge node and in the MikroTik —
#  never in the cloud, never in git, never in a Vercel env var.
# =============================================================================


# -----------------------------------------------------------------------------
# A. CLOUD — Vercel
# -----------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# --- Brand / URLs -------------------------------------------------------------
# These are placeholders. Swap in the real domain in exactly one place.
APP_NAME="Wavly WiFi"
PORTAL_URL=https://portal.wavlywifi.com
ADMIN_URL=https://admin.wavlywifi.com
PUBLIC_URL=https://wavlywifi.com
HOTSPOT_DNS_NAME=portal.wavlywifi.com
DEFAULT_SITE_CODE=nkawie-01
TIMEZONE=Africa/Accra

# --- Database (Supabase) ------------------------------------------------------
# Use the SESSION pooler (port 5432) for the app; it holds prepared statements.
# The TRANSACTION pooler (6543) is for the edge node only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side ONLY. Bypasses RLS. Never in a browser bundle.
SUPABASE_ANON_KEY=                    # unused by the SSR portal; kept for future client features
DATABASE_SSL_MODE=require

# --- Session / cookie security ------------------------------------------------
SESSION_COOKIE_NAME=wavly_sid
SESSION_SECRET=                       # 64+ random bytes, base64. Rotating it logs everyone out.
CSRF_COOKIE_NAME=wavly_csrf
ADMIN_SESSION_HOURS=8
CUSTOMER_SESSION_HOURS=2

# --- Password hashing / OTP ---------------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
OTP_PEPPER=                           # 32 random bytes, base64. Hashed WITH the OTP code.
                                      # Rotating this invalidates outstanding codes only.

# --- Encryption of secret values stored in `settings` -------------------------
# libsodium secretbox key, 32 bytes base64 (crypto_secretbox_KEYBYTES).
SETTINGS_ENC_KEY=
# Separate key for admin TOTP secrets, so a settings leak does not expose 2FA seeds.
ADMIN_TOTP_ENC_KEY=

# --- Paystack -----------------------------------------------------------------
PAYSTACK_MODE=test                    # test | live
PAYSTACK_SECRET_KEY=sk_test_xxx       # sk_live_xxx in production
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Webhook signing uses the SAME secret key as the API. Confirmed: Paystack signs
# x-paystack-signature = HMAC-SHA512(secretKey, RAW_REQUEST_BODY).
# Your Express route MUST read the raw body (express.raw({type:'application/json'}))
# before any JSON parsing, or the signature will never verify.
PAYSTACK_WEBHOOK_PATH=/webhooks/paystack
PAYSTACK_CALLBACK_URL=https://portal.wavlywifi.com/payments/paystack/callback
# Provider codes are DATA, not code — see settings.payments.momo_provider_codes.
# Paystack documentation has listed AirtelTigo as both 'atl' and 'tgo' over time.
# Verify live with: GET /bank?country=ghana&type=mobile_money
PAYSTACK_MOMO_PROVIDER_MTN=mtn
PAYSTACK_MOMO_PROVIDER_TELECEL=vod
PAYSTACK_MOMO_PROVIDER_AIRTELTIGO=atl
PAYSTACK_TIMEOUT_MS=15000
# A synthetic email is required by Paystack; customers here have none.
PAYSTACK_FALLBACK_EMAIL_DOMAIN=portal.wavlywifi.com

# --- Arkesel SMS --------------------------------------------------------------
ARKESEL_API_KEY=
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2
ARKESEL_SENDER_ID=WAVLY               # max 11 chars, must be registered in the Arkesel dashboard
ARKESEL_SANDBOX=false
# Delivery reports arrive UNAUTHENTICATED, in batches, at this URL. The handler
# must resolve sms_id against messages.provider_message_id and ignore unknowns.
ARKESEL_CALLBACK_URL=https://portal.wavlywifi.com/webhooks/arkesel/delivery
SMS_DAILY_SPEND_CAP_PESEWAS=50000

# --- Edge node auth (cloud side) ----------------------------------------------
# The edge node calls /internal/edge/* with a bearer token whose sha256 is stored
# in api_tokens. Mint it in the admin dashboard, not here.
EDGE_INGEST_PATH=/internal/edge

# --- Cron ---------------------------------------------------------------------
# Vercel Cron calls this every minute. The shared secret stops the internet from
# calling it for you.
CRON_SECRET=
CRON_PATH=/internal/cron/tick

# --- Alerting -----------------------------------------------------------------
# Where "the edge node has not sent a heartbeat in 10 minutes" goes.
ALERT_EMAIL=
ALERT_SMS_E164=
ALERT_WEBHOOK_URL=

# --- Object storage (receipt PDFs, voucher PDFs, config exports) ---------------
STORAGE_DRIVER=local                  # local | s3
STORAGE_LOCAL_DIR=./var/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# B. EDGE NODE — /etc/wavly/edge.env  (chmod 600)
# -----------------------------------------------------------------------------

# Identity
EDGE_NODE_ID=                         # uuid; matches api_tokens.subject_id
EDGE_SITE_CODE=nkawie-01
EDGE_NODE_NAME=nkawie-edge-01

# Cloud endpoint (OUTBOUND only — nothing here requires an inbound port)
CLOUD_BASE_URL=https://portal.wavlywifi.com
CLOUD_API_TOKEN=wvly_edge_            # bearer token; sha256 stored in api_tokens
CLOUD_REALTIME_URL=wss://<project-ref>.supabase.co/realtime/v1
SUPABASE_REALTIME_KEY=                # anon key is sufficient for Realtime if RLS allows
LONG_POLL_FALLBACK_SECONDS=15         # used when the Realtime websocket is down
FULL_RECONCILE_MINUTES=15

# Local Postgres that FreeRADIUS reads
EDGE_DATABASE_URL=postgresql://radius:<password>@127.0.0.1:5432/wavly_edge

# --- RADIUS -------------------------------------------------------------------
RADIUS_BIND_ADDRESS=192.168.88.10     # LAN address of the edge node
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# THE SHARED SECRET LIVES ONLY HERE AND IN THE MIKROTIK.
# One per router; key is nas_devices.name in the cloud.
RADIUS_SECRET_NKAWIE_HAP_AX3=
RADIUS_COA_PORT=3799
RADIUS_COA_ENABLED=true
RADIUS_COA_RETRIES=3

# Degraded mode: keep authenticating from the local cache when the cloud is
# unreachable. TRUE deliberately — a Starlink outage should cost new signups,
# not existing subscribers. Bounded by DEGRADED_MAX_AGE_HOURS.
DEGRADED_MODE_AUTH=true
DEGRADED_MAX_AGE_HOURS=48

# Accounting uplink
USAGE_PUSH_BATCH_SIZE=200
USAGE_PUSH_INTERVAL_SECONDS=30
USAGE_OUTBOX_MAX_ATTEMPTS=200
INTERIM_UPDATE_SECONDS=300
HEARTBEAT_SECONDS=60

# Activation handshake — the LAN HTTP endpoint the router-hosted page calls to
# exchange a one-time token for RADIUS credentials. Bound to the MANAGEMENT
# network only; never reachable from the hotspot client network.
ACTIVATION_BIND_ADDRESS=192.168.88.10
ACTIVATION_PORT=8787
ACTIVATION_TOKEN_TTL_SECONDS=60

# Backup
BACKUP_DIR=/var/backups/wavly
BACKUP_RETAIN_DAILY=14
BACKUP_UPLOAD_URL=                    # r2:/b2:/s3: target for off-site copies
BACKUP_AGE_KEY=                       # age(1) recipient for encrypting dumps

# --- Data protection ----------------------------------------------------------
# FreeRADIUS must NOT store submitted cleartext passwords in radpostauth.pass.
# This flag is asserted at syncd startup and refuses to run if the queries.conf
# override is missing. See docs/decisions.md D13.3 and Act 843.
REQUIRE_POSTAUTH_PASSWORD_REDACTION=true

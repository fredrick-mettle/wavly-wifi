# --- secrets: never commit, never partially commit ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
edge.env
# RADIUS shared secrets and router config exports can contain them
deploy/secrets/
deploy/**/*secret*
# Rendered FreeRADIUS config: holds the edge DB password and the RADIUS shared
# secret. The TEMPLATES in deploy/edge/freeradius/ are committed; this output is
# not. It also writes its own .gitignore, but that only exists after a successful
# run - this rule covers the first run and any custom --out.
deploy/edge/local/
*.env.local

# --- node --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- build / runtime artifacts ----------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/
coverage/
*.tsbuildinfo

# --- local data: receipts, voucher PDFs, backups, sqlite --------------------
var/
data/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.sql.zst

# --- editor / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- logs --------------------------------------------------------------------
logs/
*.log

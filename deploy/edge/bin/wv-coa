#!/usr/bin/env bash
# =============================================================================
# wv-coa — send a CoA or Disconnect-Request to a MikroTik NAS
# =============================================================================
# WHY THIS EXISTS
#
# FreeRADIUS can originate CoA with `update coa { ... }`, but ONLY while handling
# an incoming Access-Request or Accounting-Request. The documentation is explicit
# that it cannot be placed in pre-proxy or post-proxy, and more importantly there
# is no packet to hang it on when a subscription expires on a wall clock.
#
# That is exactly our most important case. A monthly customer's subscription ends
# at 23:59 on the 14th; nothing arrives from the router at that moment. Without an
# out-of-band CoA, expiry only takes effect at their next re-authentication -
# which for a monthly plan with no Session-Timeout could be days later. They would
# keep using a service they have stopped paying for, and the customer who is
# throttled by the site queue because of it is the one who did pay.
#
# So syncd (Phase 4) shells out to this. It is a thin, strictly-validated wrapper
# around radclient: a shell script because an operator on site needs to be able to
# run it by hand to test, and because spawning a binary is simpler and more robust
# than implementing a RADIUS client in Node.
#
# USAGE
#   wv-coa disconnect --nas 192.168.89.1 --user 0244123456 [--session <id>] [--mac AA:BB:..]
#   wv-coa throttle   --nas 192.168.89.1 --user 0244123456 --rate '2M/4M' [--session <id>]
#
# The secret is read from $WV_COA_SECRET, or from the file named by
# $WV_COA_SECRET_FILE. Never passed as an argument: on a multi-user box, argv is
# world-readable via /proc, and this secret can disconnect every paying customer.
#
# EXIT CODES
#   0  NAS replied CoA-ACK / Disconnect-ACK
#   1  usage or validation error (nothing was sent)
#   2  NAS replied NAK (it understood the packet and refused it)
#   3  no reply / timeout (the NAS may be down, or the firewall dropped it)
#
# The distinction between 2 and 3 matters and is the reason they are separate: a
# NAK means the router is fine and our attributes are wrong, while a timeout means
# the CoA path itself is broken. Retrying a NAK is pointless; retrying a timeout
# is the only thing that helps.
# =============================================================================

set -euo pipefail

# Parameter expansion, not `basename`: that is an external command, and this
# script can be invoked from a minimal environment (a stripped cron PATH, an
# early-boot unit) where a failed basename would abort it before it printed
# anything useful. radclient itself is external, but nothing should break before
# we get that far.
PROG="${0##*/}"
NAS_PORT="${WV_COA_PORT:-3799}"
RETRIES="${WV_COA_RETRIES:-2}"
TIMEOUT="${WV_COA_TIMEOUT:-3}"

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit 1; }
usage() {
  # Print the header comment between the two banner lines, minus the leading '# '.
  sed -n '3,41p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

# --- validate an IPv4 address ------------------------------------------------
# Not cosmetic. This value is interpolated into a radclient attribute list; a
# malformed value produces a confusing parse error from radclient rather than a
# clear one from us.
require_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "invalid IPv4 address: '$1'"
  local IFS=. ; local -a o=($1)
  for n in "${o[@]}"; do (( n <= 255 )) || die "invalid IPv4 address: '$1'"; done
}

# --- normalise a MAC to the form MikroTik expects ---------------------------
# RouterOS is configured with radius-mac-format=XX:XX:XX:XX:XX:XX, so it matches
# upper-case colon-separated. A client that reports itself with hyphens or in
# lower case would produce a CoA that matches no session - and the failure is
# silent, because the NAS happily ACKs a CoA that identified nothing... or NAKs it.
# Either way, normalising removes a whole class of "the disconnect did not work".
normalize_mac() {
  local m="${1//-/:}"
  m="${m//./:}"
  m="${m^^}"
  [[ "$m" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || die "invalid MAC address: '$1'"
  printf '%s' "$m"
}

# --- the shared secret ------------------------------------------------------
read_secret() {
  if [[ -n "${WV_COA_SECRET_FILE:-}" ]]; then
    [[ -r "$WV_COA_SECRET_FILE" ]] || die "cannot read WV_COA_SECRET_FILE: $WV_COA_SECRET_FILE"
    # tr -d strips the trailing newline a text file would otherwise contribute,
    # which would silently produce an authenticator mismatch and a timeout.
    SECRET="$(tr -d '\r\n' < "$WV_COA_SECRET_FILE")"
  elif [[ -n "${WV_COA_SECRET:-}" ]]; then
    SECRET="$WV_COA_SECRET"
  else
    die "set WV_COA_SECRET or WV_COA_SECRET_FILE (never pass the secret as an argument: argv is world-readable in /proc)"
  fi
  [[ -n "$SECRET" ]] || die "the RADIUS shared secret is empty"
}

# NOTE: the radclient dependency is checked just before sending, NOT here.
# Validation is instant and side-effect free, so doing it first means a typo'd
# invocation reports the typo rather than "radclient not found", and means this
# script can be exercised (and its argument handling tested) on a machine that
# does not have FreeRADIUS installed at all.

# Checked before the action is consumed, otherwise `wv-coa --help` treats
# "--help" as the action and reports a missing --nas instead of showing help.
case "${1:-}" in -h|--help) usage 0 ;; esac

[[ $# -ge 1 ]] || usage 1
ACTION="$1"; shift

NAS=""; USER=""; SESSION=""; MAC=""; RATE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --nas)     NAS="${2:-}";     shift 2 ;;
    --user)    USER="${2:-}";    shift 2 ;;
    --session) SESSION="${2:-}"; shift 2 ;;
    --mac)     MAC="${2:-}";     shift 2 ;;
    --rate)    RATE="${2:-}";    shift 2 ;;
    --port)    NAS_PORT="${2:-}"; shift 2 ;;
    -h|--help) usage 0 ;;
    *)         die "unknown argument: $1" ;;
  esac
done

[[ -n "$NAS" ]]  || die "--nas is required (the router's address, e.g. 192.168.89.1)"
[[ -n "$USER" ]] || die "--user is required (the RADIUS username)"
require_ipv4 "$NAS"
[[ "$NAS_PORT" =~ ^[0-9]+$ ]] || die "--port must be numeric"
read_secret

case "$ACTION" in
  disconnect)
    # RFC 5176: a Disconnect-Request must contain NO authorization attributes,
    # or the NAS replies Disconnect-NAK with Unsupported-Attribute. So this is
    # deliberately just session identification.
    PKT_TYPE="disconnect"
    ;;
  throttle)
    [[ -n "$RATE" ]] || die "throttle requires --rate, e.g. '2M/4M' (upload/download, bits/s)"
    # Sanity-check the shape before sending. MikroTik accepts what we send here
    # and applies it verbatim, so a typo like "2M/4K" is not an error - it is
    # 80 customers on a 4 kilobit connection.
    [[ "$RATE" =~ ^[0-9]+[kM]?(/[0-9]+[kM]?)?(\ .*)?$ ]] \
      || die "--rate '$RATE' does not look like a Mikrotik-Rate-Limit value (e.g. 2M/4M)"
    PKT_TYPE="coa"
    ;;
  *)
    die "unknown action '$ACTION' (expected: disconnect | throttle)"
    ;;
esac

# --- build the packet --------------------------------------------------------
# Session identification: RFC 5176 requires at least one identifying set. We
# always send User-Name and NAS-IP-Address, and add Acct-Session-Id and
# Calling-Station-Id when known. More identifiers is better here - a CoA that
# matches the wrong session disconnects a paying customer who has done nothing
# wrong, which is the single worst thing this script can do.
PACKET="User-Name = \"${USER//\"/\\\"}\"
NAS-IP-Address = ${NAS}"
[[ -n "$SESSION" ]] && PACKET+="
Acct-Session-Id = \"${SESSION//\"/\\\"}\""
[[ -n "$MAC" ]] && PACKET+="
Calling-Station-Id = \"$(normalize_mac "$MAC")\""
[[ "$PKT_TYPE" == "coa" ]] && PACKET+="
Mikrotik-Rate-Limit = \"${RATE//\"/\\\"}\""

# --- send --------------------------------------------------------------------
command -v radclient >/dev/null 2>&1 \
  || die "radclient not found - install freeradius-utils (Debian: apt install freeradius-utils)"

# -x prints the packet and the reply, which is what you want in a log when this
# is being investigated at 2am. -c/-r/-t bound the retry behaviour so a NAS that
# has stopped answering cannot make syncd hang.
set +e
REPLY="$(printf '%s\n' "$PACKET" \
  | radclient -x -c 1 -r "$RETRIES" -t "$TIMEOUT" "${NAS}:${NAS_PORT}" "$PKT_TYPE" "$SECRET" 2>&1)"
RC=$?
set -e

printf '%s\n' "$REPLY"

if (( RC == 0 )); then
  case "$REPLY" in
    *"Disconnect-ACK"*|*"CoA-ACK"*)     exit 0 ;;
    *"Disconnect-NAK"*|*"CoA-NAK"*)     exit 2 ;;
    *)
      # radclient exits 0 on some reply paths; treat an unrecognised reply as a
      # NAK rather than reporting success for something we cannot confirm.
      # Claiming a disconnect succeeded when it did not is how a customer stays
      # online for free for a month.
      printf '%s: unrecognised reply from %s; treating as NAK\n' "$PROG" "$NAS" >&2
      exit 2 ;;
  esac
fi

# radclient returns non-zero on timeout/no reply.
printf '%s: no ACK from %s:%s (rc=%d)\n' "$PROG" "$NAS" "$NAS_PORT" "$RC" >&2
exit 3
